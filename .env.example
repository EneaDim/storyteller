# =========================
PROFILE=dev
LOG_LEVEL=INFO
STORE_OUTPUTS=0

# =========================
# LLM (Local via Ollama)
# =========================
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b-instruct

# If your app uses these:
OLLAMA_BASE_URL=http://ollama:11434

# =========================
# STT (Free + Local)
# =========================
STT_PROVIDER=faster_whisper_local
STT_MODEL=base
STT_LANGUAGE=it

# =========================
# TTS (Free + Local, 2 voices)
# =========================
TTS_PROVIDER=piper_http
PIPER_TTS_URL=http://piper:8000
PIPER_TTS_FORMAT=mp3

# Voice models downloaded by piper_init
PIPER_MODELS_DIR=/models
PIPER_VOICE_F=it_IT-paola-medium
PIPER_VOICE_M=it_IT-riccardo-x_low

# Podcast speaker mapping
PODCAST_VOICE_NARRATOR=female
PODCAST_VOICE_EXPERT=male

# =========================
# S3 / MinIO (optional for Gradio)
# =========================
S3_ENDPOINT=http://minio:9000
S3_BUCKET=podcasts
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123456

# =========================
# Postgres / Redis
# =========================
POSTGRES_DB=podcast
POSTGRES_USER=podcast
POSTGRES_PASSWORD=podcast
DATABASE_URL=postgresql+psycopg://podcast:podcast@postgres:5432/podcast

REDIS_URL=redis://redis:6379/0

# =========================
# Telegram (not needed for Gradio quickstart)
# =========================
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=

# =========================
# Paid providers (optional)
# =========================
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_TOKEN=
HUGGINGFACE_INFERENCE_URL=
